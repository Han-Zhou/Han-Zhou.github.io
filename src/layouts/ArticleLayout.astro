---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  kicker: string;
  placeholder?: boolean;
}

const { title, description, date, kicker, placeholder = false } = Astro.props;
---

<BaseLayout title={`${title} — Han Zhou`} description={description}>
  <article>
    <h1>{title}</h1>
    <p class="article-meta">
      <time>{date}</time> · {kicker}
      {placeholder && <span> · placeholder content</span>}
    </p>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
