---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/content';

const writing = (await getCollection('writing', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = (await getCollection('notes', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <p>
    Hi I'm Han :)) I'm studying math and computer science.
  </p>
  <p>
    I like zoning out, learning things that are mostly useless, playing soccer, and doing
    calisthenics.
  </p>
  <p>Check out some fun <a href="/visualizations/">visualizations</a>!</p>

  <h2 class="section-title">Scribbles</h2>
  <PostList
    items={writing.map((entry) => ({
      href: `/scribbles/${entry.id}/`,
      title: entry.data.title,
      date: formatDate(entry.data.date),
    }))}
  />

  <h2 class="section-title">Gig</h2>
  <PostList
    items={notes.map((entry) => ({
      href: `/gig/notes/${entry.id}/`,
      title: entry.data.title,
      date: formatDate(entry.data.date),
    }))}
  />
</BaseLayout>
