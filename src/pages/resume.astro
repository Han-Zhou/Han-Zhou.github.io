---
import BaseLayout from '../layouts/BaseLayout.astro';

const pdf = '/Han_Zhou_resume.pdf';
---

<BaseLayout
  title="Résumé — Han Zhou"
  description="Han Zhou's résumé: math, computer science, and machine learning research and engineering."
>
  <h1>Résumé</h1>
  <p class="resume-actions">
    <a href={pdf} download>Download PDF</a>
    <a href={pdf} target="_blank" rel="noopener">Open in a new tab</a>
  </p>
  <object class="resume-frame" data={pdf} type="application/pdf" aria-label="Han Zhou's résumé">
    <p>Your browser can't show the PDF here. <a href={pdf}>Open the résumé</a> instead.</p>
  </object>
</BaseLayout>
