---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/content';

const writing = (await getCollection('writing', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Scribbles — Han Zhou"
  description="Articles, research notes, tutorials, and assorted observations by Han Zhou."
>
  <h1>Scribbles</h1>
  <p class="muted">Technical explanations, unfinished questions, and ideas that survived contact with a keyboard.</p>
  <p>Also: <a href="/scribbles/reading-list/">reading list</a></p>
  <PostList
    items={writing.map((entry) => ({
      href: `/scribbles/${entry.id}/`,
      title: entry.data.title,
      date: formatDate(entry.data.date),
      summary: entry.data.description,
    }))}
  />
</BaseLayout>
